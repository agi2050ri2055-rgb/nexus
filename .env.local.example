# Copy this file to .env.local and fill in your real values.
# .env.local is already in .gitignore — never remove it from there,
# and never paste real keys into any file that gets committed to GitHub.

# From build.nvidia.com -> API Keys -> Generate API Key (starts with nvapi-)
NVIDIA_API_KEY=nvapi-your-key-here

# From your Supabase project -> Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key-here
